{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hexa Template",
  "scopeName": "source.hexpat",
  "fileTypes": ["hexpat", "hexa"],
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#preprocessor"
        },
        {
          "include": "#import"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#characters"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.hexpat",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.hexpat"
            }
          }
        },
        {
          "name": "comment.block.hexpat",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.hexpat"
            }
          }
        },
        {
          "name": "comment.line.documentation.hexpat",
          "match": "(///|//!).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.hexpat"
            }
          }
        },
        {
          "name": "comment.line.double-slash.hexpat",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.hexpat"
            }
          }
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.hexpat",
          "match": "^\\s*(#)\\s*(include)\\b\\s*(?:(<[^>]*>)|(\\\"[^\\\"]*\\\"))?",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.hexpat"
            },
            "2": {
              "name": "keyword.control.directive.include.hexpat"
            },
            "3": {
              "name": "string.quoted.other.lt-gt.include.hexpat"
            },
            "4": {
              "name": "string.quoted.double.include.hexpat"
            }
          }
        },
        {
          "name": "meta.preprocessor.pragma.hexpat",
          "begin": "^\\s*(#)\\s*(pragma)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.directive.hexpat"
            },
            "2": {
              "name": "keyword.control.directive.pragma.hexpat"
            },
            "3": {
              "name": "entity.other.attribute-name.pragma.hexpat"
            }
          },
          "end": "(?=//|/\\*)|$",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "match": "\\S+",
              "name": "string.unquoted.pragma.hexpat"
            }
          ]
        },
        {
          "name": "meta.preprocessor.macro.hexpat",
          "match": "^\\s*(#)\\s*(define|undef)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.hexpat"
            },
            "2": {
              "name": "keyword.control.directive.define.hexpat"
            },
            "3": {
              "name": "entity.name.function.preprocessor.hexpat"
            }
          }
        },
        {
          "name": "meta.preprocessor.hexpat",
          "match": "^\\s*(#)\\s*(ifdef|ifndef|if|elif|else|endif|error)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.hexpat"
            },
            "2": {
              "name": "keyword.control.directive.conditional.hexpat"
            }
          }
        }
      ]
    },
    "import": {
      "name": "meta.import.hexpat",
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.hexpat"
        }
      },
      "end": ";|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.hexpat"
        }
      },
      "patterns": [
        {
          "match": "\\*",
          "name": "constant.language.wildcard.hexpat"
        },
        {
          "match": "\\.",
          "name": "punctuation.separator.hexpat"
        },
        {
          "match": "\\b(as)\\b",
          "name": "keyword.control.import.hexpat"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.namespace.hexpat"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.hexpat",
      "begin": "\\[\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.begin.hexpat"
        }
      },
      "end": "\\]\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.end.hexpat"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "(?<=\\[\\[|,)\\s*([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.hexpat"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct|union|bitfield)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.hexpat"
            },
            "2": {
              "name": "entity.name.type.$1.hexpat"
            }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.hexpat"
            },
            "2": {
              "name": "entity.name.type.enum.hexpat"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.hexpat"
            },
            "2": {
              "name": "entity.name.function.hexpat"
            }
          }
        },
        {
          "match": "\\b(using|typedef)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*::)",
          "captures": {
            "1": {
              "name": "storage.type.alias.hexpat"
            },
            "2": {
              "name": "entity.name.type.alias.hexpat"
            }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "storage.type.namespace.hexpat"
            },
            "2": {
              "name": "entity.name.namespace.hexpat"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:if|else|match|switch|case|default|while|for|do|return|break|continue)\\b",
          "name": "keyword.control.hexpat"
        },
        {
          "match": "\\b(?:struct|union|enum|bitfield|fn|using|typedef|namespace)\\b",
          "name": "storage.type.hexpat"
        },
        {
          "match": "\\b(?:le|be|auto|let|local|const|in|out|ref|unsigned|signed)\\b",
          "name": "storage.modifier.hexpat"
        },
        {
          "match": "\\b(?:sizeof|addressof|typeof)\\b",
          "name": "keyword.operator.word.hexpat"
        },
        {
          "match": "\\b(?:this|parent)\\b",
          "name": "variable.language.hexpat"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(?:[us](?:8|16|24|32|48|64|96|128)|i(?:8|16|24|32|48|64|96|128)|f(?:16|32|64)|float|double|char16|char|bool|string|str|wstring|string16|padding)\\b",
          "name": "support.type.primitive.hexpat"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false|null)\\b",
          "name": "constant.language.hexpat"
        },
        {
          "match": "\\$",
          "name": "variable.language.offset.hexpat"
        }
      ]
    },
    "function-calls": {
      "match": "\\b(?!(?:if|while|for|match|switch|return|sizeof|addressof|typeof)\\b)([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.hexpat"
        }
      }
    },
    "namespaces": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.hexpat"
        },
        "2": {
          "name": "punctuation.separator.namespace.hexpat"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f](?:[0-9A-Fa-f_']*[0-9A-Fa-f])?[uUlL]*\\b",
          "name": "constant.numeric.hex.hexpat"
        },
        {
          "match": "\\b0[bB][01](?:[01_']*[01])?[uUlL]*\\b",
          "name": "constant.numeric.binary.hexpat"
        },
        {
          "match": "\\b0[oO][0-7](?:[0-7_']*[0-7])?[uUlL]*\\b",
          "name": "constant.numeric.octal.hexpat"
        },
        {
          "match": "(?:\\b\\d(?:[\\d_']*\\d)?\\.\\d*|\\B\\.\\d+)(?:[eE][+-]?\\d+)?[fFdD]?\\b|\\b\\d(?:[\\d_']*\\d)?(?:[eE][+-]?\\d+[fFdD]?|[fFdD])\\b",
          "name": "constant.numeric.float.hexpat"
        },
        {
          "match": "\\b\\d(?:[\\d_']*\\d)?[uUlL]*\\b",
          "name": "constant.numeric.decimal.hexpat"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hexpat",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.hexpat"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.hexpat"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "match": "\\{[^{}\\\"]*\\}",
          "name": "constant.other.placeholder.hexpat"
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.hexpat",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.hexpat"
        }
      },
      "end": "'|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.hexpat"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "escapes": {
      "match": "\\\\(?:[nrtv0abfe\\\\'\\\"?]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3})",
      "name": "constant.character.escape.hexpat"
    },
    "operators": {
      "patterns": [
        {
          "match": "@",
          "name": "keyword.operator.placement.hexpat"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.hexpat"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.range.hexpat"
        },
        {
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=",
          "name": "keyword.operator.assignment.compound.hexpat"
        },
        {
          "match": "==|!=|<=|>=",
          "name": "keyword.operator.comparison.hexpat"
        },
        {
          "match": "&&|\\|\\||\\^\\^|!",
          "name": "keyword.operator.logical.hexpat"
        },
        {
          "match": "<<|>>|&|\\||\\^|~",
          "name": "keyword.operator.bitwise.hexpat"
        },
        {
          "match": "<|>",
          "name": "keyword.operator.comparison.hexpat"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.hexpat"
        },
        {
          "match": "\\+\\+|--|\\+|-|\\*|/|%",
          "name": "keyword.operator.arithmetic.hexpat"
        },
        {
          "match": "\\?|:",
          "name": "keyword.operator.ternary.hexpat"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ";",
          "name": "punctuation.terminator.statement.hexpat"
        },
        {
          "match": ",",
          "name": "punctuation.separator.delimiter.hexpat"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.hexpat"
        },
        {
          "match": "[{}]",
          "name": "punctuation.section.block.hexpat"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.hexpat"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.brackets.hexpat"
        }
      ]
    }
  }
}
