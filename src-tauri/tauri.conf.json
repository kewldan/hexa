{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexa",
  "version": "0.1.0",
  "identifier": "dev.kewldan.hexa",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Hex editor",
    "longDescription": "Hexa is a fast cross-platform hex editor for files of any size.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "bin",
          "dat",
          "img",
          "rom",
          "dump",
          "dmp",
          "raw"
        ],
        "name": "Binary data",
        "description": "Binary file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "hex",
          "ihx",
          "srec",
          "s19",
          "s28",
          "s37"
        ],
        "name": "Firmware image",
        "description": "Intel HEX or S-Record firmware",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "ips",
          "ups",
          "bps",
          "vcdiff",
          "bsdiff"
        ],
        "name": "Binary patch",
        "description": "Binary patch",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "hexaview"
        ],
        "name": "Hexa view",
        "description": "Hexa view state",
        "role": "Viewer",
        "rank": "Owner"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
